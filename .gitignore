# Publish the playable game and the sources used to build it.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/game/
!/prototype_dev/
!/characters/

/game/*
!/game/index.html
!/game/story.js
!/game/favicon.png
!/game/LICENSE
!/game/NOTICE.md
!/game/COMMERCIAL-USE.md
!/game/engine/
!/game/lib/
!/game/assets/
/game/assets/*
!/game/assets/characters/
!/game/assets/backgrounds/

/prototype_dev/**
!/prototype_dev/**/
!/prototype_dev/BACKGROUNDS.md
!/prototype_dev/POSE_SUBSTITUTIONS.md
!/prototype_dev/build_prototype.py
!/prototype_dev/package_prototype.py
!/prototype_dev/parse_story.cjs
!/prototype_dev/verify_prototype.py
!/prototype_dev/browser_routes.cjs
!/prototype_dev/browser_evidence.cjs
!/prototype_dev/scenario_v9/[0-1][0-9]_*.md
!/prototype_dev/test_runtime/package.json
!/prototype_dev/test_runtime/package-lock.json
!/prototype_dev/upstream/vn-vertical-engine-update/release-manifest.json

/characters/**
